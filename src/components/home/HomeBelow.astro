---
import JsonLd from '../seo/JsonLd.astro';

const isEn = Astro.locals.starlightRoute.lang === 'en';
const prefix = isEn ? '/en' : '';

const copy = isEn
	? {
			pathsTitle: 'Learning paths',
			pathsLede:
				'Four sections, each with a place to start. Read them in any order, or follow the sequence below if this is your first time.',
			stepsTitle: 'A good order to follow',
			stepsLede: 'Three stops are enough to get a triangle on screen.',
			note: 'You can read every tutorial in any browser. The live examples need a browser with WebGPU.',
			paths: [
				{
					href: `${prefix}/guides/getting-started/`,
					kicker: 'Guides',
					title: 'Start with the basics',
					description:
						'See what WebGPU is for, check browser support, and learn the objects that send work to the GPU.',
					cta: 'Start the tutorial',
				},
				{
					href: `${prefix}/reference/example/`,
					kicker: 'API reference',
					title: 'Look up the core interfaces',
					description:
						'GPU, GPUAdapter, GPUDevice, the canvas context, and the queue — what each one is responsible for.',
					cta: 'Open the API reference',
				},
				{
					href: `${prefix}/examples/triangle/`,
					kicker: 'Examples',
					title: 'Run a triangle',
					description:
						'A complete render pass you can see on the page: vertex shader, fragment shader, and command submit.',
					cta: 'Run the example',
				},
				{
					href: `${prefix}/resources/resouces/`,
					kicker: 'Further reading',
					title: 'Spec and ecosystem',
					description:
						'The W3C spec, WGSL, MDN, and entry points for engines such as Babylon.js and Three.js.',
					cta: 'Browse resources',
				},
			],
			steps: [
				{
					href: `${prefix}/guides/getting-started/`,
					title: 'Introduction',
					description: 'What WebGPU can do, and whether this browser can run it.',
				},
				{
					href: `${prefix}/guides/fundamental-object/`,
					title: 'Fundamental objects',
					description: 'Adapter, device, command encoder, and queue — the base for every later chapter.',
				},
				{
					href: `${prefix}/examples/triangle/`,
					title: 'First triangle',
					description: 'Put the pipeline together and see a frame on the canvas.',
				},
			],
		}
	: {
			pathsTitle: '学习路径',
			pathsLede: '站点分成四块，可以按需要跳读。第一次接触 WebGPU 的话，按下面的顺序最省事。',
			stepsTitle: '建议的顺序',
			stepsLede: '三站就够在画布上看到第一个三角形。',
			note: '教程在任何浏览器里都能阅读。页面里的实时示例需要支持 WebGPU 的浏览器。',
			paths: [
				{
					href: `${prefix}/guides/getting-started/`,
					kicker: '教程',
					title: '从介绍开始',
					description: '弄清 WebGPU 用来做什么、浏览器是否支持，以及把工作送到 GPU 需要哪些对象。',
					cta: '开始教程',
				},
				{
					href: `${prefix}/reference/example/`,
					kicker: 'API 参考',
					title: '查阅核心接口',
					description: 'GPU、GPUAdapter、GPUDevice、画布上下文和队列，各自负责什么。',
					cta: '打开 API 参考',
				},
				{
					href: `${prefix}/examples/triangle/`,
					kicker: '实例',
					title: '跑一个三角形',
					description: '在页面里看一条完整的渲染通道：顶点着色器、片段着色器，以及命令如何提交。',
					cta: '运行示例',
				},
				{
					href: `${prefix}/resources/resouces/`,
					kicker: '延伸',
					title: '规范与生态',
					description: 'W3C 规范、WGSL、MDN，以及 Babylon.js、Three.js 等引擎的入口。',
					cta: '查看资源',
				},
			],
			steps: [
				{
					href: `${prefix}/guides/getting-started/`,
					title: '介绍',
					description: 'WebGPU 能做什么，以及当前浏览器能不能跑。',
				},
				{
					href: `${prefix}/guides/fundamental-object/`,
					title: '基础对象',
					description: '适配器、设备、命令编码器和队列，后面每一章都站在这上面。',
				},
				{
					href: `${prefix}/examples/triangle/`,
					title: '第一个三角形',
					description: '把管线接起来，在画布上看到第一帧。',
				},
			],
		};
---

<div class="home-sections not-content">
	<section class="home-section" aria-labelledby="home-paths-title">
		<h2 id="home-paths-title">{copy.pathsTitle}</h2>
		<p class="lede">{copy.pathsLede}</p>
		<div class="path-grid">
			{
				copy.paths.map((path) => (
					<a class="path-card" href={path.href}>
						<span class="kicker">{path.kicker}</span>
						<span class="path-title">{path.title}</span>
						<span class="path-desc">{path.description}</span>
						<span class="path-cta">
							{path.cta}
							<span aria-hidden="true">→</span>
						</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="home-section" aria-labelledby="home-steps-title">
		<h2 id="home-steps-title">{copy.stepsTitle}</h2>
		<p class="lede">{copy.stepsLede}</p>
		<ol class="steps">
			{
				copy.steps.map((step, index) => (
					<li>
						<a href={step.href}>
							<span class="step-index" aria-hidden="true">
								{index + 1}
							</span>
							<span class="step-title">{step.title}</span>
							<span class="step-desc">{step.description}</span>
						</a>
					</li>
				))
			}
		</ol>
		<p class="note">{copy.note}</p>
	</section>
</div>

<JsonLd />

<style>
	.home-sections {
		display: flex;
		flex-direction: column;
		gap: 2.75rem;
		margin-top: 0.5rem;
	}

	.home-section h2 {
		margin: 0 0 0.45rem;
		font-size: clamp(1.45rem, calc(1.1rem + 1vw), 1.85rem);
		line-height: 1.25;
		color: var(--sl-color-white);
	}

	.lede,
	.note {
		margin: 0;
		max-width: 62ch;
		color: var(--sl-color-gray-2);
		line-height: 1.65;
	}

	.lede {
		margin-bottom: 1.15rem;
	}

	.path-grid,
	.steps {
		display: grid;
		gap: 0.85rem;
	}

	.path-card,
	.steps a {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		height: 100%;
		padding: 1.05rem 1.1rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.9rem;
		background: var(--sl-color-bg-nav);
		color: inherit;
		text-decoration: none;
		outline-offset: 3px;
	}

	.path-card:hover,
	.steps a:hover {
		border-color: var(--sl-color-text-accent);
	}

	.path-card:focus-visible,
	.steps a:focus-visible {
		outline: 2px solid var(--sl-color-text-accent);
	}

	.kicker {
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-xs);
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.path-title,
	.step-title {
		color: var(--sl-color-white);
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.35;
	}

	.path-desc,
	.step-desc {
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.6;
	}

	.path-desc {
		flex: 1;
	}

	.path-cta {
		margin-top: 0.45rem;
		color: var(--sl-color-text-accent);
		font-size: var(--sl-text-sm);
		font-weight: 600;
	}

	.steps {
		list-style: none;
		margin: 0 0 0.9rem;
		padding: 0;
	}

	.step-index {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.7rem;
		height: 1.7rem;
		border-radius: 999rem;
		background: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		font-size: var(--sl-text-xs);
		font-weight: 700;
	}

	.note {
		font-size: var(--sl-text-sm);
	}

	@media (min-width: 42rem) {
		.path-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	@media (min-width: 50rem) {
		.steps {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
</style>
